# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Gravity Room — environment surface (same-origin on the VPS)                 ║
# ╠══════════════════════════════════════════════════════════════════════════╣
# ║ The web container serves the Vite/React PWA and the api container runs the  ║
# ║ Elysia API (src/dev-server.ts) behind the same origin. Production vars live ║
# ║ in /opt/gravity-room-deploy/.env on the VPS; this file is the local-dev     ║
# ║ template. Canonical registry: apps/backend/api/src/lib/env-validation.ts.   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Required: Database (Postgres) ───────────────────────────────────────────

# Postgres connection used at request time. The api keeps a pool of up to 10
# connections with prepared statements and sends `app.service_role` as a startup
# parameter, so point it at Postgres itself, not a PgBouncer endpoint.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gzclp

# Direct (non-pooled) Postgres connection. Used ONLY by the deploy step
# `migrate-deploy` (drizzle migrations + idempotent seeds), which must run DDL
# serially against a direct connection, never PgBouncer. Falls back to
# DATABASE_URL when unset.
# Local development may omit it and fall back to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/gzclp

# TLS for the Postgres connection. Defaults to `require` when NODE_ENV=production
# (and off otherwise), so you normally never set this. Set DB_SSL=false ONLY for
# a local non-TLS Postgres you are running in production mode.
# DB_SSL=false

# ─── Required: Auth ──────────────────────────────────────────────────────────

# JWT signing secret — use a long random string (min 64 chars in production).
JWT_SECRET=dev-secret-change-me

# Google OAuth client ID (web).
GOOGLE_CLIENT_ID=<your-google-client-id>

# Comma-separated Google OAuth client IDs accepted by the mobile auth endpoints.
GOOGLE_CLIENT_IDS=<android-google-client-id>,<ios-google-client-id>,<web-google-client-id>

# ─── Required in production: State (Redis) ───────────────────────────────────

# Presence, caches and rate limiting live in Redis. MANDATORY in production: the
# API throws at startup if it is missing while NODE_ENV=production. When unset in
# local dev, presence/caches/rate-limiting degrade gracefully (no-op / cache miss).
# REDIS_URL=redis://:PASSWORD@127.0.0.1:6379

# ─── Required in production: Internal / cron auth ────────────────────────────

# Shared Bearer secret guarding the manual ops path of /api/internal/* routes
# (readiness, cleanup-tokens, purge-users, analytics/compute). Generate at least
# 32 random bytes (for example: `openssl rand -hex 32`). It MUST differ from
# CRON_SECRET. Presented as `Authorization: Bearer <secret>` or
# `x-internal-secret: <secret>`; every internal request is also rate-limited.
# INTERNAL_SECRET=<64-character-random-hex>

# CRON_SECRET is REQUIRED in production. The VPS cron (/etc/cron.d/gravity-room)
# sends `Authorization: Bearer <CRON_SECRET>` on every scheduled invocation,
# which the internal routes accept. Without it EVERY scheduled cron request gets
# 401 and cleanup/purge/analytics silently stop running. Generate at least 32
# random bytes and use a value distinct from INTERNAL_SECRET. It is not needed
# for local dev.
# CRON_SECRET=<different-64-character-random-hex>

# ─── Network (same-origin) ───────────────────────────────────────────────────

# Allowed CORS origin for the web frontend. LEAVE EMPTY for the same-origin
# production deployment — the SPA and API share an origin, so no CORS is needed
# and an empty value means "no cross-origin allowed" in production. Set a value
# only for split-origin local dev (e.g. the Vite dev server on another port).
CORS_ORIGIN=

# Address of the Node server (src/dev-server.ts): local dev and the VPS image.
# HOST unset listens on every address. The VPS sets HOST=127.0.0.1, because the
# api container shares the host network.
PORT=3001
# HOST=127.0.0.1

# Trust X-Forwarded-For for rate-limit keying. REQUIRED as "true" in production,
# behind the edge Caddy: the right-most X-Forwarded-For entry is the client IP.
# Without it the runtime keys every caller as 'unknown'.
# TRUSTED_PROXY=true

# Access-token lifetime (default: 15m).
# JWT_ACCESS_EXPIRY=15m

# ─── Optional: Analytics cron ────────────────────────────────────────────────

# Bounded batch size processed per /api/internal/analytics/compute cron tick
# (least-recently-computed users). Integer 1..100; default: 50.
# ANALYTICS_BATCH_SIZE=50

# ─── Optional: Observability ─────────────────────────────────────────────────

# Sentry DSN for @sentry/node error + performance tracing (leave empty locally).
# Pull-based Prometheus and /metrics were removed; logs are pino JSON on stdout.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# pino log level: debug | info | warn | error (default: info).
# LOG_LEVEL=info

# ─── Optional: Email + social auth providers ─────────────────────────────────

# Resend configuration for verification and password-reset emails. In production,
# email/password signup and forgot-password fail closed unless both RESEND_API_KEY
# and EMAIL_FROM are configured.
# RESEND_API_KEY=
# EMAIL_FROM="Gravity Room <noreply@example.com>"

# Explicit LOCAL-only escape hatch for completing email flows without Resend.
# Full bearer action links are logged only when this is true and NODE_ENV is
# exactly development. Never enable in production.
# LOG_AUTH_ACTION_LINKS=false

# Trusted public origin used for OAuth/OIDC redirects and same-origin email
# links. Required in production on the VPS; it pins the canonical domain.
# Production never trusts Host/X-Forwarded-Host for this value. Local
# development falls back to the request origin or localhost:3001.
# API_PUBLIC_URL=https://gravityroom.app

# Apple Sign in with Apple Services ID.
# APPLE_CLIENT_ID=com.example.gravityroom.web

# GitHub OAuth app credentials.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft identity platform credentials for Microsoft/Outlook sign-in.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=consumers

# ─── Optional: Admin ─────────────────────────────────────────────────────────

# Comma-separated UUIDs of admin users (for program definition approval).
# ADMIN_USER_IDS=

# ─── Optional: Telegram Notifications ────────────────────────────────────────

# Bot token from @BotFather and chat ID for new-user alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── Optional: Dev-only feature flags ────────────────────────────────────────

# Enables POST /api/auth/dev (E2E test sign-in). Hard-disabled in production —
# the route is never registered when NODE_ENV=production.
# AUTH_DEV_ROUTE_ENABLED=false
# AUTH_DEV_ROUTE_SECRET=e2e-dev-secret-not-for-prod

# Exposes /swagger UI and /swagger/json. Hard-disabled in production.
# SWAGGER_ENABLED=false

# ─── REMOVED (do not reintroduce) ────────────────────────────────────────────
# METRICS_TOKEN          → /metrics + prom-client deleted; use Sentry + pino logs.
# DB_POOL_SIZE           → the pool size is fixed in code (max=10).
# COMPUTE_INTERVAL_HOURS → analytics scheduling is the VPS cron.

# ─── Web (apps/frontend/web, Vite build-time) ────────────────────────────────

# API base URL baked into the SPA at build time. Set to "" (empty) for the
# same-origin production deployment so the SPA issues relative /api requests.
# The web Dockerfile already sets VITE_API_URL="" for you. For split-origin
# local dev, point it at the local API instead.
VITE_API_URL=

# Google OAuth web client ID. REQUIRED for web Google sign-in — the SPA reads
# import.meta.env.VITE_GOOGLE_CLIENT_ID at build time. Use the same web client ID
# as the API's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>

# Optional: Sentry DSN for the web client (browser error + performance tracing).
# VITE_SENTRY_DSN=

# Optional: Plausible analytics domain for the web client.
# VITE_PLAUSIBLE_DOMAIN=

# ─── Mobile (apps/frontend/mobile, Expo) ─────────────────────────────────────

# Production mobile builds must point at the deployed same-origin domain. For
# local development against a dev API, set
# EXPO_PUBLIC_API_URL=http://localhost:3001 instead.
EXPO_PUBLIC_API_URL=https://gravityroom.app
EXPO_PUBLIC_GOOGLE_CLIENT_ID=<optional-fallback-google-client-id>
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<android-google-client-id>
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-google-client-id>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-google-client-id>
