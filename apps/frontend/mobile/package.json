    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@gzclp/api-client": "workspace:*",
    "@gzclp/domain": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^54.0.23",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.8",
    "expo-font": "^14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.8",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.2",
    "babel-preset-expo": "^54.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|.bun|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "main": "index.js"
}
