{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "i18n:check": "pnpm exec jest src/lib/i18n/i18n.test.ts --runInBand",
    "lint": "pnpm exec eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix",
    "routes:check": "node scripts/generate-route-manifest.mjs --check",
    "routes:generate": "node scripts/generate-route-manifest.mjs",
    "test": "pnpm exec jest --runInBand",
    "typecheck": "pnpm run routes:check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@gzclp/api-client": "workspace:*",
    "@gzclp/domain": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "expo": "^54.0.36",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.0.4",
    "react": "19.1.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.1.17",
    "babel-preset-expo": "^54.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|.bun|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  }
}
