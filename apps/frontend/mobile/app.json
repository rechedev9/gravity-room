{
  "expo": {
    "name": "Gravity Room",
    "slug": "gravity-room-mobile",
    "scheme": "gravity-room-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "backgroundColor": "#111110",
    "splash": {
      "image": "./assets/splash-mark.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#111110"
    },
    "android": {
      "package": "com.gravityroom.mobile",
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "backgroundColor": "#111110",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#111110"
      }
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-notifications",
      "expo-router"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
