# Static server inside the web image. The edge Caddy adds TLS, compression and the security headers.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	# A missing hashed asset gets a 404, never the SPA shell under the immutable header.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The SPA shell must revalidate, or browsers keep an old index.html that points at deleted hashed assets.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
